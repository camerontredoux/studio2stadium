APP_NAME=
APP_KEY==
HEALTH_SECRET=

SITE_URL=
API_URL=
MARKETING_SITE_URL=
# Optional, comma separated: more origins the marketing site is served from (CORS, checkout endpoints only)
MARKETING_SITE_ORIGINS=

LOG_LEVEL=debug

TZ=UTC
PORT=3333
HOST=localhost

LIMITER_STORE=
SESSION_DRIVER=

DATABASE_URL=

REDIS_HOST=
REDIS_PORT=
REDIS_USERNAME=
REDIS_PASSWORD=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# r2 in production. fs stores uploads in apps/backend/storage and serves them
# from /uploads on this backend; the R2_* variables can stay empty then.
DRIVE_DISK=fs
R2_BUCKET=
R2_KEY=
R2_SECRET=
R2_ENDPOINT=

MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=
# Gets the "new school application" email; defaults to abbey@studio2stadium.com.
APPLICATION_ALERT_EMAIL=

STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_YEARLY=
STRIPE_PRICE_ID_SEASON_PASS=
STRIPE_PRICE_ID_WEEK_PASS=
STRIPE_PRICE_ID_EVENT_TIER_CORE=
STRIPE_PRICE_ID_EVENT_TIER_REGIONAL=
STRIPE_PRICE_ID_EVENT_TIER_NATIONAL=

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Week Pass emails. Leave the switches off until the review-only activation
# steps are done. See app/shared/week-pass-emails/config.ts.
WEEK_PASS_WELCOME_EMAIL_ENABLED=false
WEEK_PASS_EXPIRED_EMAIL_ENABLED=false
# ISO 8601 instant, e.g. 2026-12-01T17:00:00Z
WEEK_PASS_EMAILS_ACTIVE_FROM=
WEEK_PASS_EMAILS_TIMEZONE=America/Denver
WEEK_PASS_EMAIL_ASSET_BASE_URL=
MAIL_POSTAL_ADDRESS=
EMAIL_SUPPRESSION_IMPORTED_AT=
# The one internal mailbox allowed to receive Week Pass sample emails.
WEEK_PASS_SAMPLE_RECIPIENT=
# JSON object of image file name to https URL for the Week Pass emails, e.g.
# {"hero-welcome.jpg":"https://cdn.example.com/hero.jpg"}. Set at runtime.
WEEK_PASS_EMAIL_ASSETS=
# Sender API token for the read-only send-time opt-out check. Secret: set it
# with `fly secrets set`, never in a committed file.
SENDER_API_TOKEN=
