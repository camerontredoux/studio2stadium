    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@react-email/preview-server": "5.2.10",
    "@types/react": "^19",
    "prettier": "^3.8.1",
    "react-email": "^5.2.10",
    "tsup": "^8.5.1",
    "typescript": "^5.8"
  },
  "tsup": {
    "entry": [
      "./src/index.ts"
    ],
    "outDir": "./build",
    "format": "esm",
    "dts": true,
    "target": "esnext",
    "platform": "node",
    "skipNodeModulesBundle": true
